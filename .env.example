# Server-side only: export ORS_API_KEY in the backend process environment.
# Never put the ORS key in a VITE_ variable.

# Demo mode for prod build set via CI; you can switch it locally
VITE_USE_SAMPLE=0

# Local FastAPI backend
VITE_API_BASE=http://localhost:8000

# Host port published by Docker Compose
BACKEND_PORT=8000
