# Server-side only: export ORS_API_KEY in the backend process environment.
# Never put the ORS key in a VITE_ variable.

# Server-side only. The route endpoint is enabled only when this is exactly "1".
ENABLE_ROUTE_API=0

# Demo mode for prod build set via CI; you can switch it locally
VITE_USE_SAMPLE=0

# Browser-visible CARTO key restricted to localhost and 127.0.0.1.
VITE_CARTO_API_KEY=

# Local FastAPI backend
VITE_API_BASE=http://localhost:8000

# Host port published by Docker Compose
BACKEND_PORT=8000
